{application, hikyaku, [
    {description, "Email library for Erlang with SMTP, SendGrid, Mailgun and Amazon SES adapters"},
    {vsn, git},
    {registered, []},
    {mod, {hikyaku_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        gen_smtp
    ]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/Taure/hikyaku"}]}
]}.
